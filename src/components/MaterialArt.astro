---
interface Props { subject?: string; }
const { subject } = Astro.props;
---
<svg viewBox="0 0 400 250" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs><pattern id={`paper-${subject}`} width="22" height="22" patternUnits="userSpaceOnUse"><path d="M22 0H0V22" fill="none" stroke="var(--grid)" stroke-width="1" /></pattern></defs>
  <rect width="400" height="250" fill="var(--surface)" />
  <rect width="400" height="250" fill={`url(#paper-${subject})`} />
  {subject === 'math' ? <g>
    <text x="36" y="54">Общий знаменатель</text>
    <g stroke="var(--accent)" stroke-width="1.5">{Array.from({ length: 12 }, (_, i) => <rect x={36 + i * 24} y="88" width="24" height="36" fill={i < 8 ? 'var(--accent)' : 'var(--surface)'} />)}</g>
    <g stroke="var(--warm)" stroke-width="1.5">{Array.from({ length: 12 }, (_, i) => <rect x={36 + i * 24} y="140" width="24" height="36" fill={i < 3 ? 'var(--warm)' : 'var(--surface)'} />)}</g>
    <text x="36" y="218">2/3 + 1/4 = 11/12</text>
  </g> : subject === 'geometry' ? <g>
    <g fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"><path d="M35 80H365M35 175H365M115 225 285 25" /></g>
    <g fill="var(--tint)" stroke="var(--warm)" stroke-width="2"><path d="M238.25 80H267.25A29 29 0 0 0 257 58Z" /><path d="M157.5 175H186.5A29 29 0 0 0 176.3 153Z" /></g>
    <text x="36" y="66" class="variable">a</text><text x="36" y="162" class="variable">b</text><text x="275" y="222">a ∥ b</text>
  </g> : <g>
    <rect x="100" y="28" width="200" height="200" fill="var(--tint)" stroke="var(--accent)" stroke-width="2" />
    <path d="M240 28V228M100 168H300" fill="none" stroke="var(--accent)" stroke-width="2" />
    <text x="156" y="108" class="variable">a²</text><text x="256" y="108" class="variable">ab</text><text x="156" y="205" class="variable">ab</text><text x="258" y="205" class="variable">b²</text>
  </g>}
</svg>
<style>
  svg{display:block;width:100%;height:100%}
  text{font:600 22px 'Golos Text','Cambria Math','Segoe UI Symbol',sans-serif;fill:var(--ink)}
  .variable{font-style:italic}
</style>
