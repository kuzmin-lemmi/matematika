---
// Превью материала: картинка poster (если есть), поверх — ролик video или сам материал в уменьшенном виде без управления.
// Материал открывается с ?mode=board&preview=1 и сам показывает доску в движении (AGENTS.md, раздел 5).
// load="visible" — включается, когда превью на экране; load="hover" — при наведении на карточку,
// а на телефоне и планшете (нет мыши) — тоже когда карточка на экране.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { openHref, isReady } from '../lib';
import MaterialArt from './MaterialArt.astro';
interface Props { item: any; load?: 'visible' | 'hover'; }
const { item, load = 'hover' } = Astro.props;
const d = item.data;
const base = import.meta.env.BASE_URL;
const live = isReady(d) && !d.video && !/^https?:/.test(d.url) && d.url.endsWith('.html');
// тёмный кадр рядом с обычным: posts/<slug>-dark.jpg — подставляется в тёмной теме
const posterDark = d.poster?.replace(/(\.\w+)$/, '-dark$1');
const hasDark = posterDark && existsSync(join(process.cwd(), 'public', posterDark));
---
<div class="pv" style={`--c:${d.color}`} data-load={load} data-src={live ? openHref(d.url) + '?mode=board&preview=1' : undefined}>
  <div class="cover" aria-hidden="true">
    {d.poster ? (
      <picture>
        {hasDark && <source media="(prefers-color-scheme: dark)" srcset={base + posterDark} />}
        <img src={base + d.poster} alt="" loading="lazy" decoding="async" width="960" height="600" />
      </picture>
    ) : <MaterialArt subject={d.subject} />}
  </div>
  {d.video && <video muted loop playsinline preload="none" poster={d.poster ? base + d.poster : undefined} src={base + d.video}></video>}
  {(live || d.video) && load === 'hover' && <span class="hint" aria-hidden="true">▶</span>}
</div>

<style>
  .pv{position:relative;aspect-ratio:16/10;overflow:hidden;border-radius:inherit;isolation:isolate;background:var(--surface)}
  .cover{position:absolute;inset:0;display:grid;place-items:center}
  .cover picture,.cover img{display:block;width:100%;height:100%;object-fit:cover}
  .cover span{font-size:clamp(34px,16cqi,80px);filter:drop-shadow(0 6px 10px rgba(0,0,0,.25))}
  .pv{container-type:inline-size}
  .pv :global(iframe){position:absolute;left:0;top:0;width:1280px;height:800px;border:0;pointer-events:none;
    transform:scale(var(--s,.25));transform-origin:0 0;opacity:0;transition:opacity 250ms var(--ease-out);background:#fff}
  .pv video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 250ms var(--ease-out)}
  .pv.on :global(iframe),.pv.on video{opacity:1}
  .hint{position:absolute;right:8px;bottom:8px;z-index:2;display:grid;place-items:center;width:26px;height:26px;
    font-size:11px;color:#fff;background:rgba(0,0,0,.4);border-radius:50%;transition:opacity .3s}
  .pv.on .hint{opacity:0}
  @media (hover:none){ .pv[data-load="hover"] .hint{display:none} }
</style>

<script>
  const W = 1280;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches
    || (navigator as any).connection?.saveData;
  const live: HTMLElement[] = [];
  const touch = matchMedia('(hover: none)').matches;
  const MAX_LIVE = touch ? 1 : 2;             // одновременно «живых» превью: на телефоне одно — легче прокрутке
  const SETTLE = 400;                         // на телефоне материал грузится, когда палец остановился
  const timers = new WeakMap<HTMLElement, number>();
  const leaving = new WeakMap<HTMLElement, number>();   // iframe ещё в DOM, пока плавно гаснет
  const FADE = 260;                                     // чуть дольше transition opacity (250 мс)

  const fit = (el: HTMLElement) => el.style.setProperty('--s', String(el.clientWidth / W));

  function start(el: HTMLElement) {
    // материал ещё не успел исчезнуть — возвращаем его на экран, не создавая заново
    const pending = leaving.get(el);
    if (pending) {
      clearTimeout(pending);
      leaving.delete(el);
      el.classList.add('on');
      live.push(el);
      while (live.length > MAX_LIVE) stop(live[0]);
      return;
    }
    const video = el.querySelector('video');
    if (video) {
      if (!video.src) return;
      video.play().then(() => el.classList.add('on')).catch(() => {});
    } else if (el.dataset.src && !el.querySelector('iframe')) {
      const f = document.createElement('iframe');
      f.src = el.dataset.src;
      f.tabIndex = -1;
      f.title = '';
      f.setAttribute('aria-hidden', 'true');
      f.setAttribute('inert', '');
      f.addEventListener('load', () => {
        // материал на том же сайте: без звука и без захвата фокуса; режим доски он включает сам по ?mode=board&preview=1
        try {
          const w = f.contentWindow as any;
          w.AudioContext = w.webkitAudioContext = undefined;
          // превью не забирает фокус: иначе браузер прокручивает страницу назад к материалу (скачки на телефоне)
          const noop = () => {};
          w.HTMLElement.prototype.focus = w.SVGElement.prototype.focus = noop;
          w.Element.prototype.scrollIntoView = noop;
        } catch {}
        setTimeout(() => el.classList.add('on'), 150);
      });
      fit(el);
      el.appendChild(f);
    } else return;
    live.push(el);
    while (live.length > MAX_LIVE) stop(live[0]);
  }

  function stop(el: HTMLElement) {
    el.classList.remove('on');
    el.querySelector('video')?.pause();
    const frame = el.querySelector('iframe');
    if (frame) {
      clearTimeout(leaving.get(el));
      leaving.set(el, window.setTimeout(() => { frame.remove(); leaving.delete(el); }, FADE));
    }
    const i = live.indexOf(el);
    if (i >= 0) live.splice(i, 1);
  }

  const ro = new ResizeObserver(es => es.forEach(e => fit(e.target as HTMLElement)));
  const io = new IntersectionObserver(es => es.forEach(e => {
    const el = e.target as HTMLElement;
    clearTimeout(timers.get(el));
    if (!e.isIntersecting) { stop(el); return; }
    if (touch) timers.set(el, window.setTimeout(() => start(el), SETTLE));
    else start(el);
  }), { threshold: 0.5 });

  document.querySelectorAll<HTMLElement>('.pv').forEach(el => {
    if (!el.dataset.src && !el.querySelector('video')) return;
    ro.observe(el);
    if (el.dataset.load === 'visible' || touch) {
      if (!calm) io.observe(el);
      return;
    }
    // превью при наведении на всю карточку, с задержкой — чтобы не грузить материалы при быстром проходе мышью
    const host = el.closest<HTMLElement>('[data-pv-host]') ?? el;
    let t = 0;
    host.addEventListener('mouseenter', () => { t = window.setTimeout(() => start(el), 250); });
    host.addEventListener('mouseleave', () => { clearTimeout(t); stop(el); });
  });
</script>
