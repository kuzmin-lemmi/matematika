---
// Строка списка класса: превью слева, справа — описание материала и кнопки режимов
import type { CollectionEntry } from 'astro:content';
import Preview from './Preview.astro';
import StudentLink from './StudentLink.astro';
import { ACCESS, PARTS, TYPES } from '../config';
import { pageHref, downloadName, colorVars, itemLinks } from '../lib';
interface Props { item: CollectionEntry<'items'>; n: number }
const { item, n } = Astro.props;
const d = item.data;
const { modes, sheets, download } = itemLinks(item);
---
<article class="row" style={colorVars(d.color)}>
  <a class="media" href={pageHref(item.id)} tabindex="-1" aria-hidden="true"><Preview item={item} load="visible" /></a>
  <div class="body">
    <p class="kicker ink-c"><span class="n">{n}</span>{d.topic ?? TYPES[d.type].label}</p>
    <h3><a href={pageHref(item.id)}>{d.title}</a></h3>
    <p class="sum">{d.summary}</p>
    {d.duration && <p class="facts">⏱ {d.duration}</p>}
    <div class="act">
      {modes.map(m => <a class="btn part" href={m.href}>{PARTS[m.part].icon} {PARTS[m.part].label}</a>)}
      {sheets.map(s => <a class="btn part" href={s.href}>{s.icon} {s.label}</a>)}
      <StudentLink item={item} />
      {download && <a class="btn" href={download} download={downloadName(d.url)}>⬇ Скачать</a>}
      <a class="btn" href={pageHref(item.id)}>Подробнее</a>
      {d.access !== 'free' && <span class="chip">{ACCESS[d.access]}</span>}
    </div>
  </div>
</article>

<style>
  .row{display:grid;grid-template-columns:minmax(0,380px) minmax(0,1fr);gap:clamp(14px,2.5vw,28px);align-items:start;
    padding:16px;background:var(--surface);border:1.5px solid var(--line);border-radius:16px}
  .media{display:block;border-radius:12px;overflow:hidden}
  .body{display:flex;flex-direction:column;gap:6px;min-width:0}
  .kicker{margin:0;display:flex;align-items:center;gap:8px;font-weight:700;font-size:13.5px}
  .n{flex:none;display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--cb);color:#fff;font:800 11px var(--display)}
  h3{margin:0;font-size:clamp(17px,1.7vw,21px)}
  h3 a{text-decoration:none}
  .sum{margin:0;color:var(--soft);font-size:15px}
  .facts{margin:0;color:var(--soft);font-size:14px}
  .act{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:4px}
  .act :global(.btn){padding:.5em .9em;font-size:14.5px}
  @media (pointer:coarse){ .act :global(.btn){min-height:44px;justify-content:center} }
  .part{background:var(--cb);border-color:var(--cb);color:#fff}
  @media (max-width:760px){ .row{grid-template-columns:1fr} }
</style>
