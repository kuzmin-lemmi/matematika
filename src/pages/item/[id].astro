---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import Preview from '../../components/Preview.astro';
import StudentLink from '../../components/StudentLink.astro';
import { TYPES, ACCESS, PARTS } from '../../config';
import { openPageHref, sheetHref, ogImage, gradeLabel, subjectLabel, downloadHref, downloadName, colorVars, isReady, isLocalFile } from '../../lib';

export async function getStaticPaths() {
  const items = await getCollection('items');
  return items.map(item => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);
const external = /^https?:/.test(d.url);
const ready = isReady(d);
const local = isLocalFile(d.url);
const dl = ready ? downloadHref(d) : '';
const rows = [
  ['Тип', TYPES[d.type].label],
  ['Предмет', subjectLabel(d.subject)],
  ['Класс', gradeLabel(d.grades)],
  ['Тема', d.topic],
  ['Учебник', d.textbook],
  ['Время', d.duration],
  ['Что внутри', [...d.parts.map(p => `${PARTS[p].icon} ${PARTS[p].label}`), ...d.sheets.map(s => `${s.icon} ${s.label}`)].join(' · ')],
  ['Доступ', ACCESS[d.access]],
].filter(([, v]) => v);
---
<Base title={d.title} description={d.summary} image={ogImage(item)} noindex={!ready}>
  <section class="top" style={colorVars(d.color)}>
    <div class="wrap layout">
      <div>
        <a class="back" href={`${import.meta.env.BASE_URL}catalog/`}>← Каталог</a>
        <div class="badge"><span>{d.emoji}</span></div>
        <h1>{d.title}</h1>
        <p class="lead">{d.summary}</p>
        <div class="cta">
          {ready && local && d.parts.map(p => <a class="btn primary" href={openPageHref(item, p)}>{PARTS[p].icon} {PARTS[p].label}</a>)}
          {ready && local && d.sheets.map(s => <a class="btn primary" href={sheetHref(item, s.kind)}>{s.icon} {s.label}</a>)}
          {ready && (external || !d.parts.length) && (
            <a class="btn primary" href={openPageHref(item)} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              {d.type === 'course' ? 'Перейти к курсу' : 'Открыть'} {external ? '↗' : '▶'}
            </a>
          )}
          {dl && <a class="btn" href={dl} download={downloadName(d.url)} title="Один HTML-файл: работает без интернета и с флешки">⬇ Скачать бесплатно</a>}
          <StudentLink item={item} label="🔗 Ссылка для учеников (домашняя работа)" />
          {d.repo && <a class="btn" href={d.repo}>Исходный код ↗</a>}
        </div>
        {!ready && <p class="note">Материал готовится. Ниже — что в нём будет.</p>}
        <dl class="facts">{rows.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
        <div class="text"><Content /></div>
        {d.tags.length > 0 && <p class="tags">{d.tags.map(t => <span class="chip">{t}</span>)}</p>}
      </div>
      <aside class="side">
        <div class="media"><Preview item={item} load="visible" /></div>
        {ready && <p class="cap muted">{d.video ? 'Ролик из материала' : 'Так материал выглядит на доске'}</p>}
      </aside>
    </div>
  </section>
</Base>
<style>
  .top{padding-top:28px}
  .layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,420px);gap:40px;align-items:start}
  .back{display:inline-flex;align-items:center;min-height:44px;margin-bottom:10px;color:var(--soft);text-decoration:none;font-weight:600}
  .badge{width:58px;height:58px;border-radius:10px;display:grid;place-items:center;font-size:30px;margin-bottom:18px;background:var(--tint)}
  .lead{font-size:clamp(17px,2vw,20px);color:var(--soft);max-width:60ch}
  .cta{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 28px}
  .cta :global(.btn){font:700 16px var(--body);cursor:pointer;color:var(--ink)}
  .cta .btn.primary{background:var(--cb);border-color:var(--cb);color:#fff}
  .note{margin:-8px 0 20px;font-weight:600;color:var(--soft)}
  .facts{display:grid;grid-template-columns:max-content 1fr;gap:8px 20px;margin:0 0 28px;padding:18px 20px;background:var(--surface);border:1.5px solid var(--line);border-radius:var(--r)}
  dt{color:var(--soft);font-weight:600}
  dd{margin:0}
  .text{max-width:68ch}
  .tags{display:flex;gap:6px;flex-wrap:wrap}
  .side{position:sticky;top:90px;display:flex;flex-direction:column;gap:12px}
  .media{border-radius:var(--r);overflow:hidden;border:1px solid var(--line)}
  .cap{margin:-4px 0 0;font-size:13.5px;text-align:center}
  @media (max-width:860px){ .layout{grid-template-columns:1fr} .side{position:static;order:-1} }
</style>
