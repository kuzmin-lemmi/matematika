---
import Base from '../layouts/Base.astro';
import { SUBJECTS, SITE } from '../config';

const base = import.meta.env.BASE_URL;
---
<Base title="Поиск по темам" description="Поиск тем школьной программы и материалов по математике для 5–9 классов.">
  <section class="search-page" data-site-search>
    <div class="wrap">
      <p class="eyebrow">5–9 классы · математика, алгебра и геометрия</p>
      <h1>Поиск по темам</h1>
      <p class="intro">Найдите тему в программе и подходящие материалы для урока.</p>
      <form class="search-form" data-search-form action={`${base}poisk/`} method="get" role="search">
        <label for="search-query">Тема или название материала</label>
        <div class="search-line"><input id="search-query" name="q" type="search" data-search-query placeholder="Например, дроби или квадратный корень" autocomplete="off" /><button class="btn primary" type="submit">Найти</button></div>
        <div class="examples"><span>Например:</span> <button type="button" data-search-example="дроби">дроби</button><button type="button" data-search-example="треугольники">треугольники</button><button type="button" data-search-example="корень">корень</button></div>
        <div class="filters">
          <label>Класс<select name="grade" data-search-grade><option value="">Все классы</option>{SITE.grades.map(g => <option value={g}>{g} класс</option>)}</select></label>
          <label>Предмет<select name="subject" data-search-subject><option value="">Все предметы</option>{Object.entries(SUBJECTS).map(([key, value]) => <option value={key}>{value.label}</option>)}</select></label>
          <label class="ready"><input type="checkbox" name="ready" value="1" data-search-ready /> Только с материалами</label>
        </div>
      </form>
      <noscript><p>Для поиска включите JavaScript. Темы также доступны на страницах классов.</p></noscript>
      <p class="status" data-search-status role="status" aria-live="polite"></p>
      <div data-search-results></div>
      <button class="btn more" type="button" data-search-more hidden>Показать ещё темы</button>
    </div>
  </section>
  <span hidden data-search-index={`${base}poisk.json`}></span>
</Base>
<script>
  import { initSiteSearch } from '../scripts/site-search';
  const root = document.querySelector<HTMLElement>('[data-site-search]');
  const index = document.querySelector<HTMLElement>('[data-search-index]')?.dataset.searchIndex;
  if (root && index) initSiteSearch(root, () => fetch(index).then(r => { if (!r.ok) throw new Error(String(r.status)); return r.json(); }));
</script>
<style>
  .search-page{padding:44px 0 56px}
  .eyebrow{margin:0 0 12px;color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  h1{font-size:clamp(30px,4vw,44px);margin-bottom:12px}
  .intro{color:var(--soft);margin:0 0 30px}
  .search-form{max-width:760px}
  .search-form>label{display:block;font-size:14px;font-weight:600;margin-bottom:8px}
  .search-line{display:flex;gap:10px}
  input[type=search],select{font:400 16px var(--body);color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:8px;min-height:48px;padding:10px 14px}
  input[type=search]{flex:1;min-width:0}
  .search-line button{min-width:100px;cursor:pointer}
  .examples{display:flex;align-items:center;gap:10px;flex-wrap:wrap;color:var(--soft);font-size:13px;margin-top:12px}
  .examples button{border:0;padding:3px 0;background:transparent;color:var(--accent);font:inherit;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
  .filters{display:flex;align-items:end;gap:16px;flex-wrap:wrap;margin-top:24px}
  .filters label:not(.ready){display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:600;color:var(--soft)}
  .filters select{min-width:150px;font-size:14px}
  .ready{display:flex;align-items:center;gap:8px;min-height:48px;font-size:14px}
  .ready input{width:18px;height:18px;accent-color:var(--accent)}
  .status{margin:32px 0 14px;color:var(--soft);font-size:14px}
  :global(.result-group){padding:0;margin:28px 0}
  :global(.result-group h2){font-size:20px;margin:0 0 12px}
  :global(.result-list){list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
  :global(.result-row){display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:20px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line)}
  :global(.result-title){font-size:16px;font-weight:700;text-decoration:none;grid-column:1}
  :global(.result-title:hover){color:var(--accent);text-decoration:underline}
  :global(.result-detail){grid-column:1;margin:4px 0 0;color:var(--soft);font-size:13px}
  :global(.result-status){grid-column:2;grid-row:1 / 3;color:var(--soft);font-size:12px}
  :global(.result-status.is-ready){color:var(--accent);font-weight:600}
  .more{cursor:pointer}
  .more[hidden]{display:none}
  @media(max-width:560px){.search-page{padding-top:28px}.search-line{flex-wrap:wrap}.search-line input{flex-basis:100%}.filters{gap:12px}.filters label:not(.ready){flex:1 1 130px}.filters select{min-width:0;width:100%}:global(.result-row){display:block}:global(.result-status){display:block;margin-top:7px}}
</style>
