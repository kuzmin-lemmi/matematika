---
import Base from '../../layouts/Base.astro';
import PlanMaterials from '../../components/PlanMaterials.astro';
import { getCollection } from 'astro:content';
import { klassName, gradeSubjects, isReady } from '../../lib';
import { SITE, SUBJECTS } from '../../config';
import plans from '../../data/lesson-plans.json';
import { quarterLessons, PLAN_SOURCES } from '../../lesson-plan';

export async function getStaticPaths() {
  return SITE.grades.map(g => ({ params: { grade: String(g) } }));
}
const grade = Number(Astro.params.grade);
const base = import.meta.env.BASE_URL;
const subjects = gradeSubjects(grade);
const items = (await getCollection('items'))
  .filter(item => item.data.type === 'lesson' && item.data.grades.includes(grade) && isReady(item.data))
  .sort((a, b) => a.data.order - b.data.order);
const groups = subjects.map(subject => {
  const plan = plans.find(p => p.grade === grade && p.subject === subject)!;
  const materials = items.filter(i => i.data.subject === subject);
  return {
    subject,
    quarters: [1, 2, 3, 4].map(quarter => ({
      quarter,
      lessons: quarterLessons(plan, quarter).map(lesson => ({
        ...lesson,
        materials: materials.filter(item => item.data.planLessons.some(ref => ref.grade === grade && ref.lessons.includes(lesson.annualNumber))),
      })),
    })),
    unplaced: materials.filter(item => !item.data.planLessons.some(ref => ref.grade === grade)),
  };
});
---
<Base title={`План уроков и материалы · ${klassName(grade)}`} description={`План уроков ${grade} класса по четвертям. Практика на доске, тренажёры и печатные задания рядом с темой урока.`} noindex={items.length === 0}>
  <section class="plan-page" data-lesson-plan>
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Путь к странице"><a href={base}>Главная</a><span aria-hidden="true">/</span><span>{klassName(grade)}</span></nav>
      <div class="plan-hero">
        <div><p class="eyebrow">От темы — к готовому уроку</p><h1>План уроков и материалы</h1><p class="lead">{klassName(grade)} · Подбирайте задания по ходу программы</p></div>
        <span class="grade-number" aria-hidden="true">{grade}</span>
      </div>
      <div class="subjects" data-plan-controls hidden role="group" aria-label="Предмет">
        {subjects.map(subject => <button type="button" data-subject-button={subject} aria-pressed="false">{SUBJECTS[subject].label}</button>)}
      </div>
      <div class="toolbar" data-plan-controls hidden>
        <div class="quarters" role="group" aria-label="Четверть">
          {[1,2,3,4].map(q => <button type="button" data-quarter-button={q} aria-pressed="false">{q} четверть<span data-count></span></button>)}
        </div>
        <label class="ready-filter"><input type="checkbox" data-ready-only /> Только с материалами</label>
      </div>
      <p class="plan-note">Распределение по четвертям ориентировочное. Номера уроков в каждой четверти начинаются с 1.</p>
      <p class="sr-only" data-plan-status role="status" aria-live="polite"></p>
      {groups.map(group => <>
        {group.quarters.map(({quarter, lessons}) => (
          <section class="quarter-pane" data-plan-pane data-subject={group.subject} data-quarter={quarter} aria-label={`${SUBJECTS[group.subject].label}, ${quarter} четверть`}>
            <div class="section-heading"><h2>{quarter} четверть <span>· {SUBJECTS[group.subject].label}</span></h2><span class="hint">Урок · тема · материалы</span></div>
            <ol class="lesson-list">
              {lessons.map(lesson => <li class="lesson-row" value={lesson.number} data-lesson data-annual-number={lesson.annualNumber} data-ready={lesson.materials.length > 0 ? 'true' : 'false'}>
                <div class="lesson-topic"><span class="lesson-number" aria-label={`Урок ${lesson.number}`}>{lesson.number}</span><h3>{lesson.title}</h3></div>
                <PlanMaterials items={lesson.materials} title={lesson.title} />
              </li>)}
            </ol>
            <p class="empty-quarter" data-empty hidden>К этой четверти материалы пока не добавлены. Снимите фильтр, чтобы увидеть все уроки.</p>
          </section>
        ))}
        {group.unplaced.length > 0 && <section class="unplaced" data-unplaced={group.subject}>
          <h2>Ещё материалы · {SUBJECTS[group.subject].label}</h2>
          <p class="plan-note">Готовые материалы, которые пока не привязаны к урокам плана.</p>
          {group.unplaced.map(item => <div class="lesson-row"><h3>{item.data.title}</h3><PlanMaterials items={[item]} title={item.data.title} /></div>)}
        </section>}
      </>)}
      <div class="plan-footer">
        <details><summary>Основа плана</summary><p>Темы уроков взяты из рабочих программ гимназии № 87 Саратова (2025). Четверти распределены на сайте условно по схеме 8 + 8 + 10 + 8 недель. Порядок тем может отличаться от вашего учебника и школьного календаря.</p><ul>{subjects.map(subject => <li><a href={PLAN_SOURCES[subject]}>{SUBJECTS[subject].label} — программа (PDF)</a></li>)}</ul></details>
        <a href={`${base}catalog/?grade=${grade}`}>Все материалы {grade} класса →</a>
      </div>
    </div>
  </section>
</Base>
<script>
  import { initLessonPlan } from '../../scripts/lesson-plan';
  const root = document.querySelector<HTMLElement>('[data-lesson-plan]');
  if (root) initLessonPlan(root);
</script>
<style>
  .plan-page{padding-top:24px}
  .breadcrumbs{display:flex;gap:8px;font-size:12px;color:var(--soft)}
  .breadcrumbs a{text-decoration:none}
  .plan-hero{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:26px 0}
  .eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:700;margin:0 0 12px}
  h1{font-size:clamp(26px,3.5vw,36px)}
  .lead{font-size:14px;color:var(--soft);margin:10px 0 0}
  .grade-number{font:italic 90px/1 Georgia,serif;color:var(--accent);padding-right:22px}
  .subjects{display:flex;gap:24px;border-bottom:1px solid var(--line)}
  button{font:inherit;cursor:pointer;color:var(--soft)}
  .subjects button{border:0;background:transparent;min-height:44px;padding:10px 0;border-bottom:2px solid transparent;font-size:14px;font-weight:600}
  .subjects button[aria-pressed="true"]{border-bottom-color:var(--accent);color:var(--accent)}
  .toolbar{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;padding:20px 0 10px}
  .quarters{display:flex;flex-wrap:wrap;gap:6px}
  .quarters button{min-height:44px;padding:8px 12px;border:1px solid var(--line);border-radius:4px;background:transparent;font-size:13px}
  .quarters button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
  .quarters button:hover{border-color:var(--accent)}
  [data-count]{font-size:11px}
  .ready-filter{display:flex;align-items:center;gap:6px;font-size:12px;min-height:44px}
  input{accent-color:var(--accent);width:16px;height:16px}
  .plan-note{font-size:12px;color:var(--soft);margin:0 0 20px}
  .quarter-pane{padding:0}
  .section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:12px 0 18px;border-bottom:1px solid var(--line)}
  h2{font-size:20px;margin:0}
  h2 span{font-weight:400;color:var(--soft);font-size:14px}
  .hint{font-size:12px;color:var(--soft)}
  .lesson-list{list-style:none;margin:0;padding:0}
  .lesson-row{display:grid;grid-template-columns:minmax(220px,29%) minmax(0,1fr);gap:24px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);min-height:72px}
  .lesson-topic{display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;align-items:center}
  .lesson-number{color:var(--accent);font-size:15px;font-variant-numeric:tabular-nums}
  h3{font-size:14px;line-height:1.45;letter-spacing:0;margin:0;font-weight:600;overflow-wrap:anywhere}
  .empty-quarter{font-size:14px;color:var(--soft);padding:20px 0}
  .plan-footer{display:flex;justify-content:space-between;gap:24px;align-items:start;padding-top:24px;color:var(--soft);font-size:12px}
  details{max-width:650px}summary{cursor:pointer;color:var(--accent)}
  .plan-footer>a{flex-shrink:0;color:var(--accent)}
  [hidden]{display:none!important}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:680px){.grade-number{display:none}.lesson-row{grid-template-columns:1fr;gap:6px;padding:12px 0}.lesson-topic{grid-template-columns:24px minmax(0,1fr)}.lesson-row :global(.materials){margin-left:34px}.hint{display:none}.plan-footer{flex-direction:column}.toolbar{gap:4px}.plan-hero{padding:24px 0}h2 span{display:block;margin-top:6px}}
</style>
