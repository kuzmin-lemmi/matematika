---
// Своя страница «не найдено»: GitHub Pages отдаёт её на любой несуществующий адрес сайта
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { klassHref, klassName } from '../lib';
import { SITE } from '../config';
const base = import.meta.env.BASE_URL;
---
<Base title="Страница не найдена" description="Такой страницы на сайте нет — загляни в каталог." noindex>
  <section class="nf">
    <div class="wrap">
      <Logo size={72} />
      <p class="code">404</p>
      <h1>Такой страницы нет</h1>
      <p class="lead">Возможно, ссылка устарела или в адресе опечатка. Все материалы — в каталоге.</p>
      <div class="cta">
        <a class="btn primary" href={`${base}catalog/`}>Открыть каталог</a>
        <a class="btn" href={base}>На главную</a>
      </div>
      <p class="muted">По классам: {SITE.grades.map((g, i) => <>{i > 0 && ' · '}<a href={klassHref(g)}>{klassName(g)}</a></>)}</p>
    </div>
  </section>
</Base>

<style>
  .nf{padding:clamp(48px,8vw,96px) 0;text-align:center}
  .code{font:800 clamp(64px,12vw,128px)/1 var(--display);letter-spacing:-.04em;margin:12px 0 0;color:var(--accent)}
  .lead{color:var(--soft);font-size:18px;max-width:46ch;margin:0 auto 22px}
  .cta{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:22px}
  .nf a:not(.btn){color:var(--accent);font-weight:600}
</style>
