---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import heroUnderstanding from '../assets/hero-understanding.png';
import Preview from '../components/Preview.astro';
import ShelfCard from '../components/ShelfCard.astro';
import { getCollection } from 'astro:content';
import { SITE, PARTS } from '../config';
import { openPageHref, pageHref, klassHref, klassName, isReady, subjectLabel, gradeLabel } from '../lib';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('items')).sort((a, b) => a.data.order - b.data.order);
const lessons = all.filter(i => i.data.type === 'lesson');
const more = all.filter(i => i.data.type !== 'lesson');
const hero = all.filter(i => isReady(i.data) && i.data.added)
  .sort((a, b) => (b.data.added?.getTime() ?? 0) - (a.data.added?.getTime() ?? 0) || Number(b.data.featured) - Number(a.data.featured))[0];
---
<Base>
  <section class="intro">
    <div class="hero-art" aria-hidden="true">
      <Image src={heroUnderstanding} alt="" widths={[640, 960, 1440, 1920]} sizes="100vw" format="webp" quality={82} loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap intro-in">
      <div class="intro-copy">
        <p class="eyebrow">Материалы для 5–8 классов</p>
        <h1>{SITE.name}</h1>
        <p class="lead">Покажи. Дай решить.<br /><span>Разбери.</span></p>
        <p class="intro-description">Одна тема — на доске,<br />на бумаге и дома.</p>
        <a class="btn primary hero-cta" href={`${base}catalog/`}>К материалам <span aria-hidden="true">→</span></a>
        <div class="modes" aria-label="Режимы материалов">
          {Object.entries(PARTS).map(([key, part]) => <a href={`${base}catalog/?part=${key}`}>{part.label} <span aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </div>
  </section>
  <section class="walkthrough" id="kak-rabotaet" aria-labelledby="walkthrough-title">
    <div class="wrap walkthrough-in">
      <div class="walkthrough-copy">
        <p class="eyebrow">Маленький пример</p>
        <h2 id="walkthrough-title">От вопроса —<br /> к пониманию</h2>
        <p>Сначала вопрос классу. Затем наглядный шаг. В конце — запись решения.</p>
        <p class="walkthrough-note">Попробуй разобрать сложение дробей по шагам.</p>
      </div>
      <div class="notebook squared" aria-label="Пример пошагового разбора сложения дробей">
        <div class="paper-heading"><span class="eyebrow">Сложение дробей</span><span class="example">Пример</span></div>
        <div class="equation" aria-label="Две трети плюс одна четверть">
          <span class="fraction"><span>2</span><span>3</span></span><span>+</span><span class="fraction"><span>1</span><span>4</span></span><span>=</span><span id="demo-result">?</span>
        </div>
        <div class="strips" aria-label="Восемь двенадцатых и три двенадцатых">
          <div class="strip-row"><div class="strip">{Array.from({ length: 12 }, (_, i) => <span class:list={{ filled: i < 8 }} />)}</div><span>2/3</span></div>
          <div class="strip-row"><div class="strip warm">{Array.from({ length: 12 }, (_, i) => <span class:list={{ filled: i < 3 }} />)}</div><span>1/4</span></div>
        </div>
        <p class="question" id="demo-question" aria-live="polite">Какой знаменатель подойдёт обеим дробям?</p>
        <div class="paper-footer"><span id="demo-caption">Вопрос классу</span><button class="btn primary" type="button" id="demo-next">Показать шаг <span aria-hidden="true">→</span></button></div>
        <noscript><p>Общий знаменатель — 12. Две трети — 8/12, одна четверть — 3/12. Сумма — 11/12.</p></noscript>
      </div>
    </div>
  </section>
  {hero && <section class="new"><div class="wrap"><div class="new-in"><a class="new-preview" href={pageHref(hero.id)} aria-label={hero.data.title}><Preview item={hero} load="visible" /></a><div><p class="eyebrow">Новое</p><h2>{hero.data.title}</h2><p class="muted">{hero.data.summary}</p><a class="btn primary" href={openPageHref(hero)}>Открыть материал →</a></div></div></div></section>}
  <section class="materials">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">Доска · бумага · дом</p><h2>Материалы для урока</h2></div><a class="text-link" href={`${base}catalog/`}>Весь каталог <span aria-hidden="true">→</span></a></div>
      <div class="lesson-grid">
        {lessons.map(item => <article class="lesson">
          <p class="eyebrow">{subjectLabel(item.data.subject)} · {gradeLabel(item.data.grades)}</p>
          <h3><a href={pageHref(item.id)}>{item.data.title}</a></h3>
          <p class="summary">{item.data.summary}</p>
          <div class="lesson-bottom"><span class="status">{isReady(item.data) ? 'Три режима' : 'Скоро'}</span><a href={pageHref(item.id)} aria-label={`Подробнее: ${item.data.title}`}>Подробнее <span aria-hidden="true">↗</span></a></div>
        </article>)}
      </div>
    </div>
  </section>
  <section class="classes"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">По школьной программе</p><h2>Выбери класс</h2></div><p class="books">Виленкин · Макарычев · Мерзляк</p></div><div class="class-grid">{SITE.grades.map(g => <a class="class-link" href={klassHref(g)}><b>{g}</b><span>{klassName(g)}<small>{g <= 6 ? 'Математика' : 'Алгебра и геометрия'}</small></span><span aria-hidden="true">↗</span></a>)}</div></div></section>
  {more.length > 0 && <section><div class="wrap"><h2>Курсы и программы</h2><div class="grid">{more.map(item => <ShelfCard item={item} />)}</div></div></section>}
</Base>
<script>
  const next = document.getElementById('demo-next');
  const question = document.getElementById('demo-question');
  const result = document.getElementById('demo-result');
  const caption = document.getElementById('demo-caption');
  const steps = [
    ['Общий знаменатель — 12. Разделим обе полоски на двенадцать равных долей.', 'Общий знаменатель'],
    ['2/3 = 8/12, а 1/4 = 3/12. Теперь доли одинакового размера.', 'Одинаковые доли'],
    ['8/12 + 3/12 = 11/12. Складываем числители, знаменатель сохраняем.', 'Складываем доли'],
  ];
  let step = 0;
  next?.addEventListener('click', () => {
    if (!question || !result || !caption) return;
    if (step === steps.length) {
      step = 0;
      question.textContent = 'Какой знаменатель подойдёт обеим дробям?';
      caption.textContent = 'Вопрос классу';
      result.textContent = '?';
      next.innerHTML = 'Показать шаг <span aria-hidden="true">→</span>';
      return;
    }
    [question.textContent, caption.textContent] = steps[step];
    step++;
    if (step === steps.length) {
      result.innerHTML = '<span class="fraction"><span>11</span><span>12</span></span>';
      next.textContent = 'Ещё раз ↺';
    } else next.innerHTML = 'Следующий шаг <span aria-hidden="true">→</span>';
  });
</script>
<style>
  .eyebrow{margin:0;font-size:11px;line-height:1.5;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--soft)}
  .intro{position:relative;isolation:isolate;overflow:hidden;padding:0;background:var(--bg)}
  .intro-in{position:relative;z-index:1;display:flex;align-items:center;min-height:560px;padding-top:58px;padding-bottom:58px}
  .intro-copy{width:min(100%,490px)}
  .hero-art{position:absolute;inset:0;max-width:1600px;margin:auto;pointer-events:none;mask-image:linear-gradient(to right,transparent 8%,#000 42%,#000 96%,transparent)}
  .hero-art::after{content:'';position:absolute;inset:0;background:linear-gradient(to right,var(--bg) 10%,transparent 62%),linear-gradient(to top,var(--bg),transparent 12%)}
  .hero-art :global(img){display:block;width:100%;height:100%;object-fit:cover;object-position:center 53%}
  h1{font-size:clamp(58px,7vw,88px);line-height:1;letter-spacing:-.055em;margin:19px 0 20px;font-weight:800}
  .lead{font-size:clamp(24px,2.6vw,32px);line-height:1.2;font-weight:700;letter-spacing:-.03em;margin:0}
  .lead span{color:var(--accent)}
  .intro-description{font-size:17px;line-height:1.55;color:var(--soft);margin:20px 0 23px}
  .hero-cta{min-height:46px;font-size:15px}
  .modes{display:flex;gap:20px;flex-wrap:wrap;margin-top:20px}
  .modes a{display:inline-flex;align-items:center;gap:8px;min-height:36px;text-decoration:none;font-size:13px;font-weight:600;border-bottom:2px solid var(--line)}
  .modes a:hover{border-color:var(--accent)}
  .modes a span{color:var(--soft)}
  .walkthrough{padding-top:54px;padding-bottom:40px}
  .walkthrough-in{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(30px,6vw,90px);align-items:center}
  .walkthrough-copy h2{font-size:clamp(30px,3.2vw,42px);line-height:1.12;font-weight:700;letter-spacing:-.04em;margin:14px 0 20px}
  .walkthrough-copy>p:not(.eyebrow){max-width:33ch;font-size:17px;color:var(--soft);line-height:1.6}
  .walkthrough-copy>p.walkthrough-note{font-size:14px;margin-top:22px}
  .notebook{padding:clamp(22px,3vw,36px);border:1px solid var(--line);border-radius:4px 22px 22px 4px;background-color:var(--surface);box-shadow:7px 8px 0 var(--line);transform:rotate(1deg)}
  .paper-heading,.paper-footer{display:flex;justify-content:space-between;gap:12px;align-items:center}
  .example{color:var(--soft);font-size:11px;border:1px solid var(--line);border-radius:4px;padding:2px 6px;background:var(--surface)}
  .equation{display:flex;align-items:center;gap:18px;font-size:clamp(30px,3.6vw,46px);font-weight:500;margin:26px 0}
  .fraction,.equation :global(.fraction){display:inline-flex;flex-direction:column;align-items:center;line-height:1.05;vertical-align:middle;min-width:.75em}
  .fraction>span:last-child,.equation :global(.fraction>span:last-child){border-top:2px solid currentColor;width:100%;text-align:center;padding-top:4px;margin-top:4px}
  .strip-row{display:grid;grid-template-columns:minmax(0,1fr) 28px;gap:12px;align-items:center;margin:10px 0}
  .strip-row>span{font-size:12px;color:var(--soft)}
  .strip{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));height:29px;border-left:1px solid var(--accent)}
  .strip span{border:1px solid var(--accent);border-left:0;background:var(--surface)}
  .strip .filled{background:var(--accent)}
  .strip.warm{border-left-color:var(--warm)}
  .strip.warm span{border-color:var(--warm)}
  .strip.warm .filled{background:var(--warm)}
  .question{min-height:4.5em;font-size:16px;line-height:1.5;font-weight:600;margin:22px 0;color:var(--accent)}
  .paper-footer>span{font-size:11px;color:var(--soft)}
  .paper-footer button{font-size:13px;min-height:44px;cursor:pointer;flex-shrink:0}
  .section-heading{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}
  .section-heading h2{font-size:25px;letter-spacing:-.035em;margin:7px 0 0}
  .text-link{font-size:14px;font-weight:600;text-decoration:none;white-space:nowrap;padding:8px 0}
  .lesson-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .lesson{display:flex;flex-direction:column;min-width:0;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:24px;transition:border-color 160ms var(--ease-out)}
  .lesson:hover{border-color:var(--accent)}
  .lesson h3{font-size:21px;line-height:1.3;font-weight:600;margin:20px 0 12px;letter-spacing:-.025em}
  .lesson h3 a{text-decoration:none}
  .summary{margin:0;color:var(--soft);font-size:14px;line-height:1.6;flex:1}
  .lesson-bottom{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-top:26px;font-size:12px}
  .lesson-bottom a{font-weight:600;text-decoration:none;padding:8px 0}
  .status{color:var(--soft);background:var(--tint);padding:3px 8px;border-radius:4px}
  .books{color:var(--soft);font-size:13px;margin:0}
  .class-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .class-link{display:flex;align-items:center;gap:14px;padding:24px 16px;text-decoration:none;min-width:0}
  .class-link+.class-link{border-left:1px solid var(--line)}
  .class-link b{font:400 42px/1 Georgia,serif;color:var(--accent)}
  .class-link span{font-size:14px;font-weight:600}
  .class-link small{display:block;font-size:11px;color:var(--soft);font-weight:400;margin-top:2px}
  .class-link>span:last-child{margin-left:auto;color:var(--soft)}
  .class-link:hover{background:var(--tint)}
  .new-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:center;padding:24px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
  .new-preview{border-radius:8px;overflow:hidden}
  .new-in h2{margin-top:12px}
  @media(prefers-color-scheme:dark){:global(:root:not([data-theme="light"])) .hero-art :global(img){filter:brightness(.72) saturate(.82)}}
  :global(:root[data-theme="dark"]) .hero-art :global(img){filter:brightness(.72) saturate(.82)}
  @media(max-width:800px){.intro-in{min-height:0;padding-top:38px;padding-bottom:330px}.intro-copy{width:100%;max-width:520px}h1{font-size:64px}.hero-art{inset:auto 0 0;height:320px;mask-image:linear-gradient(to bottom,transparent,#000 18%,#000 88%,transparent)}.hero-art :global(img){object-position:82% center}.hero-art::after{background:linear-gradient(to top,var(--bg),transparent 15%)}.walkthrough-in{grid-template-columns:1fr;gap:20px}.walkthrough{padding-top:28px}.walkthrough-copy>p:not(.eyebrow){max-width:42ch}.walkthrough-copy h2 br{display:none}.notebook{max-width:560px;width:100%;justify-self:center}.lesson-grid{grid-template-columns:1fr}.lesson h3{margin-top:12px}.lesson-bottom{margin-top:16px}.class-grid{grid-template-columns:1fr 1fr}.class-link:nth-child(3){border-left:0}.class-link:nth-child(n+3){border-top:1px solid var(--line)}.new-in{grid-template-columns:1fr}.section-heading{align-items:start;flex-wrap:wrap;gap:12px}}
  @media(max-width:380px){.paper-footer{align-items:flex-start;flex-direction:column}.paper-footer button{width:100%}.modes{gap:14px}.notebook{padding:20px}.class-link{padding:20px 8px;gap:10px}.class-link>span:last-child{display:none}}
  @media(prefers-reduced-motion:reduce){.lesson{transition:none}}
</style>
